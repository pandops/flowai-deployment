{
  "name": "ALL_EVENT",
  "subjects": [
    "source-controller.event.*.sub",
    "task-manager.event.*.sub",
    "journal.event.*.sub",
    "audit.event.*.sub",
    "team-registry.event.*.sub",
    "flow-registry.event.*.sub",
    "model-registry.event.*.sub",
    "env-registry.event.*.sub",
    "executor-registry.event.*.sub",
    "admin-panel.event.*.sub",
    "executor.event.*.*.sub"
  ],
  "retention": "interest",
  "storage": "file",
  "discard": "new",
  "max_consumers": -1,
  "max_msgs": -1,
  "max_bytes": -1,
  "max_age": 0,
  "max_msgs_per_subject": -1,
  "max_msg_size": -1,
  "num_replicas": 1,
  "duplicate_window": 120000000000,
  "deny_delete": true,
  "deny_purge": true,
  "allow_rollup_hdrs": false
}
