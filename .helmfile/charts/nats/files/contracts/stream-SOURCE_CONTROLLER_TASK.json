{
  "name": "SOURCE_CONTROLLER_TASK",
  "subjects": [
    "source-controller.task.*.sub"
  ],
  "retention": "workqueue",
  "storage": "file",
  "discard": "new",
  "max_consumers": -1,
  "max_msgs": -1,
  "max_bytes": -1,
  "max_age": 0,
  "max_msgs_per_subject": -1,
  "max_msg_size": -1,
  "num_replicas": 1,
  "duplicate_window": 120000000000,
  "deny_delete": true,
  "deny_purge": true,
  "allow_rollup_hdrs": false
}
