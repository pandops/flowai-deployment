map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
    listen 8443 ssl;
    server_name {{ .Values.lanAddress }};
    client_max_body_size 16m;
    ssl_certificate /run/tls/tls.crt;
    ssl_certificate_key /run/tls/tls.key;
    proxy_http_version 1.1;
    proxy_set_header Host {{ .Values.lanAddress }}:{{ .Values.port }};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host {{ .Values.lanAddress }}:{{ .Values.port }};
    proxy_set_header X-Forwarded-Port {{ .Values.port }};
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;

    location ^~ /idp/ { proxy_pass http://keycloak:8080/; }
    location ^~ /webhook/ { proxy_pass http://source-controller:8080; }
    location ^~ /v1/sources/ { proxy_pass http://source-controller:8080; }
    location ^~ /admin/v1/ { proxy_pass http://api-gateway:8080; }
    location ^~ /admin/ { proxy_pass http://admin-panel:8080; }
    location ~ ^/(auth|ui|v1)/ { proxy_pass http://api-gateway:8080; }
    location / { proxy_pass http://web-ui:8080; }
}
